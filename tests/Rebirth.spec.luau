--!nocheck
local Rebirth = require("../src/shared/Logic/Rebirth")

return function(t)
	t.test("calcula custos para rebirths 0 a 3 com floor", function()
		t.eq(Rebirth.cost(0, 10000, 2.5), 10000)
		t.eq(Rebirth.cost(1, 10000, 2.5), 25000)
		t.eq(Rebirth.cost(2, 10000, 2.5), 62500)
		t.eq(Rebirth.cost(3, 10000, 2.5), 156250)
		t.eq(Rebirth.cost(0, 10, 1.5), 10)
		t.eq(Rebirth.cost(1, 10, 1.5), 15)
	end)

	t.test("normaliza rebirths negativos e NaN para zero", function()
		t.eq(Rebirth.cost(-1, 100, 2), 100)
		t.eq(Rebirth.cost(0 / 0, 100, 2), 100)
		t.eq(Rebirth.cost(0, 0, 2), 0)
	end)

	t.test("valida saldo no limite, abaixo dele e entradas inválidas", function()
		local ok, err = Rebirth.canRebirth(100, 0, 100, 2)
		t.eq(ok, true)
		t.eq(err, nil)
		ok, err = Rebirth.canRebirth(99, 0, 100, 2)
		t.eq(ok, false)
		t.eq(err, "NOT_ENOUGH_COINS")
		ok, err = Rebirth.canRebirth(0, 0, 100, 2)
		t.eq(err, "NOT_ENOUGH_COINS")
		ok, err = Rebirth.canRebirth(-1, 0, 100, 2)
		t.eq(err, "NOT_ENOUGH_COINS")
		ok, err = Rebirth.canRebirth(0 / 0, 0, 100, 2)
		t.eq(err, "NOT_ENOUGH_COINS")
		ok, err = Rebirth.canRebirth(math.huge, 0, 100, 2)
		t.eq(err, "NOT_ENOUGH_COINS")
		ok, err = Rebirth.canRebirth(-math.huge, 0, 100, 2)
		t.eq(err, "NOT_ENOUGH_COINS")
		local invalidCoins: any = "100"
		ok, err = Rebirth.canRebirth(invalidCoins, 0, 100, 2)
		t.eq(err, "NOT_ENOUGH_COINS")
	end)
end
